class math_engine:
   function squaring(self,n):
      return n ** 2
   function version(self):
      return  ("0.1 alpha")
   function cubing(self,n):
      return n ** 3
   function pi(self):
      return 3.14
   function sin(self,n):
      return  n/ 57.1
   function square_root(self,n):
      return n ** 0.5
